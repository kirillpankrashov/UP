    "paths": {
        "/api/v1/streamer/widget/{widget}/enable": {
            "get": {
                "tags": [
                    "Widget"
                ],
                "summary": "Enable widget",
                "description": "Activates the streamer's widget overlay. This is a public endpoint typically used via a browser link.",
                "operationId": "widgetEnable",
                "parameters": [
                    {
                        "name": "widget",
                        "in": "path",
                        "description": "Widget slug",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "WGT-1741358023"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Widget enabled",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Widget not found"
                    }
                }
            }
        },
        "/api/v1/streamer/widget/{widget}/disable": {
            "get": {
                "tags": [
                    "Widget"
                ],
                "summary": "Disable widget",
                "description": "Deactivates the streamer's widget overlay. This is a public endpoint typically used via a browser link.",
                "operationId": "widgetDisable",
                "parameters": [
                    {
                        "name": "widget",
                        "in": "path",
                        "description": "Widget slug",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "WGT-1741358023"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Widget disabled",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Widget not found"
                    }
                }
            }
        }
    },
