{
  "name": "uplify",
  "version": "3.6.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=16384 vite",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint .",
    "test:unit": "cross-env NODE_OPTIONS=--max-old-space-size=16384 vitest --environment jsdom --root src/ --run",
    "test:unit:watch": "cross-env NODE_OPTIONS=--max-old-space-size=16384 vitest --environment jsdom --root src/",
    "build:production": "run-p type-check build-only:production",
    "build:development": "run-p type-check build-only:development",
    "build-only:production": "vite build",
    "build-only:development": "vite build --mode development",
    "deploy:staging": "run-s build-only:development sentry:inject sentry:upload:staging sentry:sourcemaps:delete && firebase deploy --project uplify-staging-465914",
    "deploy:production": "run-s build-only:production sentry:inject sentry:upload:production sentry:sourcemaps:delete && firebase deploy --project uplify-production",
    "sentry:inject": "sentry-cli sourcemaps inject ./dist",
    "sentry:upload:staging": "sentry-cli sourcemaps upload --release $npm_package_version ./dist",
    "sentry:upload:production": "sentry-cli sourcemaps upload --release $npm_package_version ./dist",
    "sentry:sourcemaps:delete": "find ./dist -name '*.map' -delete"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@element-plus/icons-vue": "^2.1.0",
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@kangc/v-md-editor": "^2.3.18",
    "@peculiar/webcrypto": "^1.5.0",
    "@sentry/vue": "^10.35.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.6.7",
    "axios-cache-interceptor": "^1.8.0",
    "chart.js": "^4.4.3",
    "codemirror": "^6.0.2",
    "crypto-js": "^4.2.0",
    "device-detector-js": "^3.0.3",
    "element-plus": "^2.3.8",
    "jsonwebtoken": "^9.0.2",
    "jsonwebtoken-esm": "^2.0.1",
    "jwt-simple": "^0.5.6",
    "laravel-echo": "^1.16.1",
    "laravel-vapor": "^0.7.1",
    "libphonenumber-js": "^1.12.9",
    "moment": "^2.30.1",
    "obs-websocket-js": "^5.0.7",
    "pinia": "^3.0.3",
    "prismjs": "^1.30.0",
    "pusher-js": "^8.4.0-rc2",
    "rollbar": "^2.26.2",
    "showdown": "^2.1.0",
    "uuid": "^11.1.0",
    "vite-plugin-html": "^3.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vue": "^3.3.4",
    "vue-chartjs": "^5.3.1",
    "vue-codemirror": "^6.1.1",
    "vue-i18n": "^9.2.2",
    "vue-qr": "^4.0.9",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@pinia/testing": "^1.0.2",
    "@rushstack/eslint-patch": "^1.3.2",
    "@sentry/cli": "^2.42.2",
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^27.0.0",
    "@types/laravel-vapor": "^0.6.5",
    "@types/node": "^24.8.1",
    "@types/prismjs": "^1.26.5",
    "@types/showdown": "^2.0.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/eslint-config-standard": "9.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^10.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "2",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tailwindcss": "^3.13.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.31",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "sass-embedded": "^1.93.2",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.9.3",
    "unenv": "^1.10.0",
    "vite": "^7.1.11",
    "vite-plugin-checker": "^0.11.0",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^3.2.4",
    "vitest-fail-on-console": "^0.10.1",
    "vue-eslint-parser": "^10.2.0",
    "vue-loader": "^17.2.2",
    "vue-tsc": "^3.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,vue}": [
      "eslint --fix",
      "git add"
    ]
  }
}
